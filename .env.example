# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_me_to_a_random_secret_string
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clinicuser:clinicpass@localhost:5432/clinic_db
DATABASE_URL_SYNC=postgresql://clinicuser:clinicpass@localhost:5432/clinic_db

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Meta Cloud API (WhatsApp Business) ───────────────────────────────
# Get these from Meta App Dashboard → WhatsApp → API Setup
META_ACCESS_TOKEN=EAAxxxxx
META_PHONE_NUMBER_ID=1234567890123
META_VERIFY_TOKEN=my_random_webhook_verify_secret
META_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io
META_API_VERSION=v21.0

# ── Per-Clinic Meta tokens (referenced in config.yaml as ${...}) ─────
META_ACCESS_TOKEN_WELLNESS=EAAxxxxx
META_PHONE_NUMBER_ID_WELLNESS=1234567890001
META_VERIFY_TOKEN_WELLNESS=wellness_verify_secret

META_ACCESS_TOKEN_DENTAL=EAAxxxxx
META_PHONE_NUMBER_ID_DENTAL=1234567890002
META_VERIFY_TOKEN_DENTAL=dental_verify_secret

# ── Clinics Directory ─────────────────────────────────────────────────
CLINICS_DIR=./clinics
